(allow sysctl-read
	(require-all
		(profile-flag "common-debugging-rules")
		(system-attribute developer-mode)
		(sysctl-name "vm.debug_range_enabled")
	)
)
(allow sysctl-read
	(profile-flag "autobox-client-telemetry")
)
(allow sysctl-read
	(require-all
		(profile-flag "common-exception-entitlement-rules")
		(extension "com.apple.security.exception.sysctl.read-write")
	)
)
(allow sysctl-read
	(require-all
		(sysctl-name "vm.debug_range_enabled")
		(require-any
			(require-all
				(profile-flag "common-debugging-rules")
				(require-any
					(require-all
						(profile-flag "common-exception-entitlement-rules")
						(extension "com.apple.security.exception.sysctl.read-only")
					)
					(system-attribute developer-mode)
				)
			)
			(require-all
				(profile-flag "common-exception-entitlement-rules")
				(extension "com.apple.security.exception.sysctl.read-only")
			)
		)
	)
)
(autobox sysctl-read
	(with restrictive-default)
	(require-any
		(profile-flag "autobox-client")
		(profile-flag "autobox-client-no-exception-entitlements")
	)
)
(deny sysctl-read
	(with no-report)
	(require-all
		(sysctl-name "kern.proc.pid.1")
		(profile-flag "hide-launchd")
		(profile-flag "disable-enforcement")
	)
)
(deny sysctl-read)

(allow system*
	(with report)
	(profile-flag "disable-enforcement")
)
(deny system*)

(allow system-fcntl
	(with report)
	(profile-flag "disable-enforcement")
)
(allow system-fcntl
	(require-all
		(profile-flag "common-rules")
		(require-any
			(fcntl-command F_GETFL)
			(require-all
				(fcntl-command
					F_SETFD
					F_PREALLOCATE
					F_SINGLE_WRITER
					F_OFD_SETLK
					F_SETCONFINED
					F_GETCONFINED)
				(%entitlement-is-bool-true "com.apple.coreduetd.people")
			)
		)
	)
)
(allow system-fcntl
	(require-any
		(fcntl-command F_ADDFILESIGS_RETURN F_CHECK_LV F_GETPATH)
		(profile-flag "autobox-client-telemetry")
	)
)
(autobox system-fcntl
	(require-any
		(profile-flag "autobox-client")
		(profile-flag "autobox-client-no-exception-entitlements")
	)
)
(deny system-fcntl)

(allow system-fsctl
	(with report)
	(profile-flag "disable-enforcement")
)
(allow system-fsctl
	(require-all
		(profile-flag "common-rules")
		(fsctl-command FSIOC_CAS_BSDFLAGS)
	)
)
(allow system-fsctl
	(profile-flag "autobox-client-telemetry")
)
(autobox system-fsctl
	(with restrictive-default)
	(require-any
		(profile-flag "autobox-client")
		(profile-flag "autobox-client-no-exception-entitlements")
	)
)
(deny system-fsctl)

(allow system-info
	(with report)
	(profile-flag "disable-enforcement")
)
(allow system-info
	(with report)
	(require-all
		(profile-flag "common-rules")
		(info-type "net.link.addr")
		(profile-flag "disable-enforcement")
	)
)
(allow system-info
	(require-all
		(info-type "vfs.disk-space")
		(process-attribute is-apple-signed-executable)
		(profile-flag "common-rules")
	)
)
(deny system-info
	(with no-report)
	(require-all
		(profile-flag "common-rules")
		(info-type "net.link.addr")
		(profile-flag "disable-enforcement")
	)
)
(deny system-info)

(deny system-kas-info)

(allow system-mac-syscall
	(with report)
	(profile-flag "disable-enforcement")
)
(with-filter (mac-policy-name "AMFI")
	(allow system-mac-syscall
		(require-all
			(mac-syscall-number 90)
			(profile-flag "common-syscall-rules")
		)
	)
)
(allow system-mac-syscall
	(profile-flag "autobox-client-telemetry")
)
(with-filter (mac-policy-name "Sandbox")
	(allow system-mac-syscall
		(require-any
			(mac-syscall-number 2)
			(require-all
				(mac-syscall-number 5)
				(require-any
					(profile-flag "common-exception-entitlement-rules")
					(profile-flag "common-rules")
				)
			)
			(require-all
				(mac-syscall-number 6 7 67)
				(profile-flag "common-syscall-rules")
			)
		)
	)
)
(with-filter (mac-policy-name "Sandbox")
	(allow system-mac-syscall
		(mac-syscall-number 2)
	)
)
(autobox system-mac-syscall
	(require-any
		(profile-flag "autobox-client")
		(profile-flag "autobox-client-no-exception-entitlements")
	)
)
(deny system-mac-syscall)

(allow system-memorystatus-control)

(allow system-necp-client-action)
(autobox system-necp-client-action
	(require-any
		(profile-flag "autobox-client")
		(profile-flag "autobox-client-no-exception-entitlements")
	)
)

(allow system-privilege)

(allow system-sched
	(with report)
	(profile-flag "disable-enforcement")
)
(allow system-sched
	(require-all
		(%entitlement-is-bool-true "com.apple.private.kernel.override-cpumon")
		(profile-flag "common-rules")
	)
)
(deny system-sched)

(allow system-suspend-resume
	(with report)
	(profile-flag "disable-enforcement")
)
(allow system-suspend-resume
	(require-all
		(%entitlement-is-bool-true "com.apple.private.process.suspend-resume.any")
		(profile-flag "common-rules")
	)
)
(deny system-suspend-resume)

(allow user-preference*
	(with report)
	(profile-flag "disable-enforcement")
)
(deny user-preference*)

(allow user-preference-read
	(with report)
	(profile-flag "disable-enforcement")
)
(allow user-preference-read
	(require-all
		(extension "com.apple.security.exception.shared-preference.read-only")
		(profile-flag "common-exception-entitlement-rules")
	)
)
(allow user-preference-read
	(require-all
		(profile-flag "common-exception-entitlement-rules")
		(extension "com.apple.security.exception.shared-preference.read-write")
	)
)
(allow user-preference-read
	(require-all
		(profile-flag "common-debugging-rules")
		(require-any
			(preference-domain "com.apple.PrototypeTools")
			(preference-domain "com.apple.hangtracer")
		)
	)
)
(allow user-preference-read
	(require-all
		(profile-flag "common-rules")
		(require-any
			(preference-domain "com.apple.Accessibility")
			(preference-domain "com.apple.da")
			(preference-domain "kCFPreferencesAnyApplication")
			(require-all
				(%entitlement-is-present "com.apple.private.applemediaservices")
				(require-any
					(preference-domain "com.apple.AppleMediaServices")
					(preference-domain "com.apple.storeservices.itfe")
				)
			)
		)
	)
)
(allow user-preference-read
	(require-all
		(preference-domain "com.apple.demo-settings")
