		(process-attribute is-apple-signed-executable)
	)
)
(allow user-preference-read
	(require-all
		(preference-domain "com.apple.security")
		(profile-flag "common-apple-signed-executable-rules")
		(process-attribute is-apple-signed-executable)
	)
)
(deny user-preference-read)

