(version 1)
(%extends-builtin "baseline")
(enable-profile-flag "autobox-client")
(enable-profile-flag "common-rules")
(enable-profile-flag "common-syscall-rules")
(enable-profile-flag "common-apple-internal-rules")
(enable-profile-flag "common-apple-signed-executable-rules")
(enable-profile-flag "common-mach-lookups")
(enable-profile-flag "common-sysctl-rules")
(enable-profile-flag "common-pluginkit-support")
(enable-profile-flag "generic-sandbox-extension-support")
(enable-profile-flag "common-debugging-rules")
(enable-profile-flag "common-device-access")
(enable-profile-flag "common-preferences-rules")
(enable-profile-flag "common-mobilegestalt-rules")
(enable-profile-flag "common-containermanagerd-rules")
(enable-profile-flag "common-system-logging-rules")
(enable-profile-flag "common-managed-configuration-read-rules")
(enable-profile-flag "common-exception-entitlement-rules")

;; (default) inherited from parent profile "baseline"
(delegate default)

(allow asr-parser-enter)

(allow coalition-info)

(allow consume-extension)

(allow darwin-notification-post)

(allow dynamic-code-generation)

(allow file-clone)

(allow file-graft)

(allow file-issue-extension
	(require-all
		(extension-class "com.apple.StreamingUnzipService")
		(require-any
			(subpath "${HOME}/Library/Caches/com.apple.AppConduit.staging")
			(subpath "/private/var/tmp/com.apple.AppConduit.staging")
		)
	)
)
(allow file-issue-extension
	(require-all
		(extension-class "com.apple.nsurlsessiond.readonly")
		(extension "com.apple.sandbox.executable")
	)
)
(deny file-issue-extension
	(require-all
		(require-not (extension "com.apple.app-sandbox.read"))
		(require-not (extension "com.apple.app-sandbox.read-write"))
		(require-not (extension "com.apple.security.exception.files.absolute-path.read-only"))
		(require-not (extension "com.apple.security.exception.files.absolute-path.read-write"))
		(require-any
			(require-any
				(literal "/System/Library/Caches/apticket.der")
				(subpath "/System/Library/Caches/com.apple.factorydata")
				(subpath "/System/Library/Caches/com.apple.kernelcaches")
			)
			(require-any
				(literal "/usr/standalone/firmware/apticket.der")
				(subpath "/private/var/hardware/FactoryData")
			)
		)
	)
)

(allow file-link)

(allow file-lock)

(allow file-map-executable
	(require-all
		(extension "com.apple.sandbox.oopjit")
		(subpath "/private/var/OOPJit")
		(require-not (%entitlement-is-present "com.apple.private.oop-jit.loader"))
	)
)
(allow file-map-executable
	(require-all
		(system-attribute carrier-build)
		(require-any
			(subpath "/AppleInternal")
			(subpath "/usr/local/lib")
		)
	)
)

(allow file-read*
	(require-all
		(extension "com.apple.sandbox.oopjit")
		(subpath "/private/var/OOPJit")
		(require-not (%entitlement-is-present "com.apple.private.oop-jit.loader"))
	)
)
(allow file-read*
	(require-all
		(subpath "/System/Library/Carrier Bundles")
		(require-any
			(regex #"^/System/Library/Carrier Bundles/.*/carrier\.plist$")
			(regex #"^/System/Library/Carrier Bundles/.*\.png$")
		)
	)
)
(allow file-read*
	(require-all
		(subpath "/private/var")
		(require-any
			(require-all
				(literal "/private/var/preferences/com.apple.networkextension.plist")
				(%entitlement-is-present "com.apple.private.networkextension.configuration")
			)
			(require-all
				(literal "/private/var/preferences/com.apple.networkextension.uuidcache.plist")
				(process-attribute is-apple-signed-executable)
			)
			(require-all
				(subpath "${FRONT_USER_HOME}")
				(require-any
					(regex #"((((^/private/var/(mobile|euser[0-9]+)/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/((com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd)|com\.apple\.sockpuppet\.activeComplications)|^/private/var/[-0-9A-F]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/(com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd))|^/private/var/[-0-9A-F]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com\.apple\.sockpuppet\.activeComplications)|^/private/var/Users/[^/]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/(com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd))|^/private/var/Users/[^/]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com\.apple\.sockpuppet\.activeComplications)")
					(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/Carrier Bundles/.*/carrier\.plist$")
					(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/Carrier Bundles/.*\.png$")
					(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/DeviceRegistry/[-0-9A-Z]+/AppConduit($|/)")
					(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com.apple.nanoprefsyncd$")
					(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com\.apple\.nano-complications$")
					(require-all
						(literal "/private/var/preferences/com.apple.networkextension.uuidcache.plist")
						(process-attribute is-apple-signed-executable)
					)
				)
			)
		)
	)
)
(allow file-read*
	(require-all
		(subpath "/AppleInternal")
		(system-attribute carrier-build)
	)
)
(allow file-read*
	(require-all
		(subpath "/usr/local/lib")
		(system-attribute carrier-build)
	)
)
(allow file-read*
	(require-any
		(literal "${FRONT_USER_HOME}/Library/ConfigurationProfiles/EffectiveUserSettings.plist")
		(literal "${FRONT_USER_HOME}/Library/Preferences/com.apple.carrier.plist")
		(literal "${FRONT_USER_HOME}/Library/UserConfigurationProfiles/EffectiveUserSettings.plist")
		(literal "/private/var/Managed Preferences/mobile/com.apple.SystemConfiguration.plist")
		(literal "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/EffectiveUserSettings.plist")
		(literal "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.nsurlstoragedresources/Library/dafsaData.bin")
		(literal "/private/var/db/com.apple.networkextension.tracker-info")
		(literal "/private/var/installd/Library/MobileInstallation/MigrationInfo.plist")
		(literal "/private/var/preferences/com.apple.NetworkStatistics.plist")
		(literal "/private/var/preferences/com.apple.networkd.plist")
		(literal "/private/var/preferences/com.apple.security.plist")
		(subpath "${FRONT_USER_HOME}/Containers/Bundle/Application")
		(subpath "${FRONT_USER_HOME}/Library/Carrier Bundles/Overlay")
		(subpath "${HOME}/Library/AppConduit")
		(subpath "${HOME}/Library/Caches/com.apple.AppConduit.staging")
		(subpath "${HOME}/Library/Logs/AirTraffic")
		(subpath "${HOME}/Library/Logs/AppConduit")
		(subpath "${PROCESS_TEMP_DIR}")
		(subpath "/AppleInternal/Applications")
		(subpath "/Applications")
		(subpath "/Developer/Applications")
		(subpath "/System/Developer/Applications")
		(subpath "/private/var/MobileDevice/ProvisioningProfiles")
		(subpath "/private/var/containers/Bundle/Application")
		(subpath "/private/var/db/MobileIdentityData")
		(subpath "/private/var/factory_mount/[^/]+/Applications")
		(subpath "/private/var/personalized_automation/Applications")
		(subpath "/private/var/personalized_debug/Applications")
		(subpath "/private/var/personalized_factory/[^/]+/Applications")
		(subpath "/private/var/tmp")
		(subpath "/private/var/tmp/com.apple.AppConduit.staging")
	)
)
(deny file-read*
	(require-any
		(literal "/System/Library/Caches/apticket.der")
		(literal "/usr/standalone/firmware/apticket.der")
		(subpath "/System/Library/Caches/com.apple.factorydata")
		(subpath "/System/Library/Caches/com.apple.kernelcaches")
		(subpath "/private/var/hardware/FactoryData")
	)
)

(allow file-read-metadata
	(require-all
		(extension "com.apple.sandbox.oopjit")
		(subpath "/private/var/OOPJit")
		(require-not (%entitlement-is-present "com.apple.private.oop-jit.loader"))
	)
)
(allow file-read-metadata
	(require-all
		(subpath "/System/Library/Carrier Bundles")
		(require-any
			(regex #"^/System/Library/Carrier Bundles/.*/carrier\.plist$")
			(regex #"^/System/Library/Carrier Bundles/.*\.png$")
		)
	)
)
(allow file-read-metadata
	(require-all
		(subpath "/private/var")
		(require-any
			(require-all
				(literal "/private/var/preferences/com.apple.networkextension.plist")
				(%entitlement-is-present "com.apple.private.networkextension.configuration")
			)
			(require-all
				(literal "/private/var/preferences/com.apple.networkextension.uuidcache.plist")
				(process-attribute is-apple-signed-executable)
			)
			(require-all
				(subpath "${FRONT_USER_HOME}")
				(require-any
					(regex #"((((^/private/var/(mobile|euser[0-9]+)/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/((com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd)|com\.apple\.sockpuppet\.activeComplications)|^/private/var/[-0-9A-F]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/(com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd))|^/private/var/[-0-9A-F]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com\.apple\.sockpuppet\.activeComplications)|^/private/var/Users/[^/]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/(com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd))|^/private/var/Users/[^/]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com\.apple\.sockpuppet\.activeComplications)")
					(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/Carrier Bundles/.*/carrier\.plist$")
					(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/Carrier Bundles/.*\.png$")
					(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/DeviceRegistry/[-0-9A-Z]+/AppConduit($|/)")
					(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com.apple.nanoprefsyncd$")
					(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com\.apple\.nano-complications$")
					(require-all
						(literal "/private/var/preferences/com.apple.networkextension.uuidcache.plist")
						(process-attribute is-apple-signed-executable)
					)
				)
			)
		)
	)
)
(allow file-read-metadata
	(require-all
		(subpath "/AppleInternal")
		(system-attribute carrier-build)
	)
)
(allow file-read-metadata
	(require-all
		(process-attribute is-apple-signed-executable)
		(require-any
			(literal "${FRONT_USER_HOME}/Library/DeviceRegistry")
			(require-all
				(subpath "/private/var")
				(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/DeviceRegistry/[-0-9A-Z]+$")
				(subpath "${FRONT_USER_HOME}")
			)
		)
	)
)
(allow file-read-metadata
	(require-all
		(subpath "/usr/local/lib")
		(system-attribute carrier-build)
	)
)
(allow file-read-metadata
	(require-any
		(literal "${FRONT_USER_HOME}/Library/ConfigurationProfiles/EffectiveUserSettings.plist")
		(literal "${FRONT_USER_HOME}/Library/Preferences/com.apple.carrier.plist")
		(literal "${FRONT_USER_HOME}/Library/UserConfigurationProfiles/EffectiveUserSettings.plist")
		(literal "${HOME}")
		(literal "${HOME}/Library/PPTDevice")
		(literal "${HOME}/Library/Preferences")
		(literal "/private/var/Managed Preferences/mobile/com.apple.SystemConfiguration.plist")
		(literal "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/EffectiveUserSettings.plist")
		(literal "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.nsurlstoragedresources/Library/dafsaData.bin")
		(literal "/private/var/db/com.apple.networkextension.tracker-info")
		(literal "/private/var/installd/Library/MobileInstallation/MigrationInfo.plist")
		(literal "/private/var/preferences/com.apple.NetworkStatistics.plist")
		(literal "/private/var/preferences/com.apple.networkd.plist")
		(literal "/private/var/preferences/com.apple.security.plist")
		(subpath "${FRONT_USER_HOME}/Containers/Bundle/Application")
		(subpath "${FRONT_USER_HOME}/Library/Carrier Bundles")
		(subpath "${FRONT_USER_HOME}/Library/Carrier Bundles/Overlay")
		(subpath "${HOME}/Library/AppConduit")
		(subpath "${HOME}/Library/Caches/com.apple.AppConduit.staging")
		(subpath "${HOME}/Library/Logs/AirTraffic")
		(subpath "${HOME}/Library/Logs/AppConduit")
		(subpath "${PROCESS_TEMP_DIR}")
		(subpath "/AppleInternal/Applications")
		(subpath "/Applications")
		(subpath "/Developer/Applications")
		(subpath "/System/Developer/Applications")
		(subpath "/private/var/MobileDevice/ProvisioningProfiles")
		(subpath "/private/var/containers/Bundle/Application")
		(subpath "/private/var/db/MobileIdentityData")
		(subpath "/private/var/factory_mount/[^/]+/Applications")
		(subpath "/private/var/personalized_automation/Applications")
		(subpath "/private/var/personalized_debug/Applications")
		(subpath "/private/var/personalized_factory/[^/]+/Applications")
		(subpath "/private/var/tmp")
		(subpath "/private/var/tmp/com.apple.AppConduit.staging")
	)
)
(deny file-read-metadata
	(require-any
		(literal "/System/Library/Caches/apticket.der")
		(literal "/usr/standalone/firmware/apticket.der")
		(subpath "/System/Library/Caches/com.apple.factorydata")
		(subpath "/System/Library/Caches/com.apple.kernelcaches")
		(subpath "/private/var/hardware/FactoryData")
	)
)

(allow file-test-existence)

(allow file-ungraft)

(allow file-write*
	(require-all
		(subpath "/private/var")
		(require-any
			(require-all
				(subpath "${FRONT_USER_HOME}")
				(require-any
					(regex #"((((^/private/var/(mobile|euser[0-9]+)/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/((com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd)|com\.apple\.sockpuppet\.activeComplications)|^/private/var/[-0-9A-F]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/(com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd))|^/private/var/[-0-9A-F]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com\.apple\.sockpuppet\.activeComplications)|^/private/var/Users/[^/]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/(com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd))|^/private/var/Users/[^/]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com\.apple\.sockpuppet\.activeComplications)")
					(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/DeviceRegistry/[-0-9A-Z]+/AppConduit($|/)")
					(subpath "/private/var/tmp")
				)
			)
			(subpath "/private/var/tmp")
		)
	)
)
(allow file-write*
	(require-any
		(subpath "${HOME}/Library/AppConduit")
		(subpath "${HOME}/Library/Caches/com.apple.AppConduit.staging")
		(subpath "${HOME}/Library/Logs/AirTraffic")
		(subpath "${HOME}/Library/Logs/AppConduit")
		(subpath "${PROCESS_TEMP_DIR}")
		(subpath "/private/var/tmp/com.apple.AppConduit.staging")
	)
)

(allow file-write-create
	(require-all
		(subpath "/private/var")
		(require-any
			(require-all
				(subpath "${FRONT_USER_HOME}")
				(require-any
					(regex #"((((^/private/var/(mobile|euser[0-9]+)/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/((com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd)|com\.apple\.sockpuppet\.activeComplications)|^/private/var/[-0-9A-F]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/(com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd))|^/private/var/[-0-9A-F]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com\.apple\.sockpuppet\.activeComplications)|^/private/var/Users/[^/]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/(com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd))|^/private/var/Users/[^/]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com\.apple\.sockpuppet\.activeComplications)")
					(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/DeviceRegistry/[-0-9A-Z]+/AppConduit($|/)")
					(subpath "/private/var/tmp")
				)
			)
			(subpath "/private/var/tmp")
		)
	)
)
(allow file-write-create
	(require-all
		(process-attribute is-apple-signed-executable)
		(vnode-type DIRECTORY)
		(require-any
			(literal "${FRONT_USER_HOME}/Library/DeviceRegistry")
			(require-all
				(subpath "/private/var")
				(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/DeviceRegistry/[-0-9A-Z]+$")
				(subpath "${FRONT_USER_HOME}")
			)
		)
	)
)
(allow file-write-create
	(require-any
		(subpath "${HOME}/Library/AppConduit")
		(subpath "${HOME}/Library/Caches/com.apple.AppConduit.staging")
		(subpath "${HOME}/Library/Logs/AirTraffic")
		(subpath "${HOME}/Library/Logs/AppConduit")
		(subpath "${PROCESS_TEMP_DIR}")
		(subpath "/private/var/tmp/com.apple.AppConduit.staging")
	)
)
(deny file-write-create
	(with no-report)
	(literal "${HOME}/Library/Logs/CrashReporter/CFNetwork_*")
)

(deny file-write-setugid)

(allow file-write-unlink
	(require-all
		(extension "com.apple.sandbox.oopjit")
		(subpath "/private/var/OOPJit")
	)
)
(allow file-write-unlink
	(require-all
		(subpath "/private/var")
		(require-any
			(require-all
				(subpath "${FRONT_USER_HOME}")
				(require-any
					(regex #"((((^/private/var/(mobile|euser[0-9]+)/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/((com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd)|com\.apple\.sockpuppet\.activeComplications)|^/private/var/[-0-9A-F]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/(com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd))|^/private/var/[-0-9A-F]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com\.apple\.sockpuppet\.activeComplications)|^/private/var/Users/[^/]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/(com\.apple\.appconduitd\.gizmostate|com\.apple\.companionappd))|^/private/var/Users/[^/]+/Library/DeviceRegistry/[-0-9A-Z]+/NanoPreferencesSync/NanoDomains/com\.apple\.sockpuppet\.activeComplications)")
					(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Library/DeviceRegistry/[-0-9A-Z]+/AppConduit($|/)")
					(subpath "/private/var/tmp")
				)
			)
			(subpath "/private/var/tmp")
		)
	)
)
(allow file-write-unlink
	(require-any
		(subpath "${HOME}/Library/AppConduit")
		(subpath "${HOME}/Library/Caches/com.apple.AppConduit.staging")
		(subpath "${HOME}/Library/Logs/AirTraffic")
		(subpath "${HOME}/Library/Logs/AppConduit")
		(subpath "${PROCESS_TEMP_DIR}")
		(subpath "/private/var/tmp/com.apple.AppConduit.staging")
	)
)

(allow fs-info)

(allow fs-quota*)

(allow fs-snapshot-mount)

(allow iokit-get-properties)

(allow iokit-open-user-client
	(require-any
		(extension "com.apple.security.exception.iokit-user-client-class")
		(iokit-registry-entry-class "AppleKeyStoreUserClient")
		(iokit-registry-entry-class "RootDomainUserClient")
	)
)

(allow iokit-open-service
	(require-any
		(%entitlement-is-present "com.apple.security.exception.iokit-user-client-class")
		(iokit-registry-entry-class "AppleKeyStore")
		(iokit-registry-entry-class "IOPMrootDomain")
	)
)

(allow ipc-posix-shm-read-data
	(require-all
		(ipc-posix-name "apple.shm.notification_center")
		(require-not (%entitlement-is-bool-true "com.apple.security.on-demand-install-capable"))
	)
)
(allow ipc-posix-shm-read-data
	(ipc-posix-name "/com.apple.AppSSO.version")
)

(deny job-creation)

(deny lsopen
	(profile-flag "deny-lsopen")
)

(allow mach-bootstrap)

(allow mach-cross-domain-lookup)

(allow mach-derive-port)

(allow mach-lookup
	(require-all
		(global-name "com.apple.ak.auth.xpc")
		(require-any
			(%entitlement-is-bool-true "com.apple.authkit.client")
			(%entitlement-is-bool-true "com.apple.authkit.client.internal")
			(%entitlement-is-bool-true "com.apple.authkit.client.private")
			(process-attribute is-apple-signed-executable)
		)
	)
)
(allow mach-lookup
	(require-all
		(global-name "com.apple.networkd_privileged")
		(require-any
			(%entitlement-is-bool-true "com.apple.networkd.advisory_socket")
			(%entitlement-is-bool-true "com.apple.networkd.disable_opportunistic")
			(%entitlement-is-bool-true "com.apple.networkd.modify_settings")
			(%entitlement-is-bool-true "com.apple.networkd.persistent_interface")
			(%entitlement-is-bool-true "com.apple.networkd_privileged")
		)
	)
)
(allow mach-lookup
	(require-all
		(global-name "com.apple.ak.anisette.xpc")
		(process-attribute is-apple-signed-executable)
	)
)
