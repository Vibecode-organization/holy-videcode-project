(version 1)
(%extends-builtin "baseline")
(enable-profile-flag "autobox-client")
(enable-profile-flag "common-rules")
(enable-profile-flag "common-syscall-rules")
(enable-profile-flag "common-apple-internal-rules")
(enable-profile-flag "common-apple-signed-executable-rules")
(enable-profile-flag "common-mach-lookups")
(enable-profile-flag "common-sysctl-rules")
(enable-profile-flag "common-pluginkit-support")
(enable-profile-flag "generic-sandbox-extension-support")
(enable-profile-flag "common-debugging-rules")
(enable-profile-flag "common-device-access")
(enable-profile-flag "common-preferences-rules")
(enable-profile-flag "common-mobilegestalt-rules")
(enable-profile-flag "common-containermanagerd-rules")
(enable-profile-flag "common-system-logging-rules")
(enable-profile-flag "common-managed-configuration-read-rules")
(enable-profile-flag "common-exception-entitlement-rules")

;; (default) inherited from parent profile "baseline"
(delegate default)

(allow asr-parser-enter)

(allow coalition-info)

(allow consume-extension)

(allow darwin-notification-post)

(allow dynamic-code-generation)

(allow file-clone)

(allow file-graft)

(allow file-issue-extension
	(require-all
		(extension-class "com.apple.app-sandbox.read")
		(require-any
			(subpath "${PROCESS_TEMP_DIR}/com.apple.pasteboard.pasted")
			(subpath "/private/var/tmp/com.apple.pasteboard.pasted")
		)
	)
)
(allow file-issue-extension
	(require-all
		(extension-class "com.apple.app-sandbox.read-write")
		(require-any
			(subpath "${PROCESS_TEMP_DIR}/com.apple.pasteboard.pasted")
			(subpath "/private/var/tmp/com.apple.pasteboard.pasted")
		)
	)
)
(allow file-issue-extension
	(require-all
		(extension-class "com.apple.mediaserverd.read-write")
		(require-any
			(subpath "${PROCESS_TEMP_DIR}/com.apple.pasteboard.pasted")
			(subpath "/private/var/tmp/com.apple.pasteboard.pasted")
		)
	)
)
(allow file-issue-extension
	(require-all
		(extension-class "com.apple.Pasteboard-readonly")
		(subpath "${FRONT_USER_HOME}/Library/Caches/com.apple.Pasteboard")
	)
)
(allow file-issue-extension
	(require-all
		(extension-class "com.apple.aned.read-only")
		(require-any
			(subpath "${PROCESS_TEMP_DIR}/com.apple.pasteboard.pasted")
			(subpath "/private/var/tmp/com.apple.pasteboard.pasted")
		)
	)
)
(allow file-issue-extension
	(require-all
		(extension-class "com.apple.mediaserverd.read")
		(require-any
			(subpath "${PROCESS_TEMP_DIR}/com.apple.pasteboard.pasted")
			(subpath "/private/var/tmp/com.apple.pasteboard.pasted")
		)
	)
)
(deny file-issue-extension
	(require-all
		(require-not (extension "com.apple.app-sandbox.read"))
		(require-not (extension "com.apple.app-sandbox.read-write"))
		(require-not (extension "com.apple.security.exception.files.absolute-path.read-only"))
		(require-not (extension "com.apple.security.exception.files.absolute-path.read-write"))
		(require-any
			(require-any
				(literal "/System/Library/Caches/apticket.der")
				(subpath "/System/Library/Caches/com.apple.factorydata")
				(subpath "/System/Library/Caches/com.apple.kernelcaches")
			)
			(require-any
				(literal "/usr/standalone/firmware/apticket.der")
				(subpath "/private/var/hardware/FactoryData")
			)
		)
	)
)

(allow file-link)

(allow file-lock)

(allow file-map-executable
	(require-all
		(extension "com.apple.sandbox.oopjit")
		(subpath "/private/var/OOPJit")
		(require-not (%entitlement-is-present "com.apple.private.oop-jit.loader"))
	)
)
(allow file-map-executable
	(require-all
		(system-attribute carrier-build)
		(require-any
			(subpath "/AppleInternal")
			(subpath "/usr/local/lib")
		)
	)
)

(allow file-read*)
(deny file-read*
	(require-any
		(literal "/System/Library/Caches/apticket.der")
		(literal "/usr/standalone/firmware/apticket.der")
		(subpath "/System/Library/Caches/com.apple.factorydata")
		(subpath "/System/Library/Caches/com.apple.kernelcaches")
		(subpath "/private/var/hardware/FactoryData")
	)
)

(allow file-test-existence)

(allow file-ungraft)

(allow file-write*
	(require-any
		(subpath "${HOME}/Library/Caches/com.apple.Pasteboard")
		(subpath "${HOME}/Library/Caches/com.apple.UIKit.pboard")
		(subpath "${PROCESS_TEMP_DIR}/com.apple.pasteboard.pasted")
		(subpath "/private/var/tmp/com.apple.pasteboard.pasted")
	)
)

(deny file-write-setugid)

(allow file-write-unlink
	(require-all
		(extension "com.apple.sandbox.oopjit")
		(subpath "/private/var/OOPJit")
	)
)
(allow file-write-unlink
	(require-any
		(subpath "${HOME}/Library/Caches/com.apple.Pasteboard")
		(subpath "${HOME}/Library/Caches/com.apple.UIKit.pboard")
		(subpath "${PROCESS_TEMP_DIR}/com.apple.pasteboard.pasted")
		(subpath "/private/var/tmp/com.apple.pasteboard.pasted")
	)
)

(allow fs-info)

(allow fs-quota*)

(allow fs-snapshot-mount)

(allow iokit-get-properties)

(allow iokit-open-user-client
	(require-any
		(extension "com.apple.security.exception.iokit-user-client-class")
		(iokit-registry-entry-class "AppleKeyStoreUserClient")
	)
)

(allow iokit-open-service
	(require-any
		(%entitlement-is-present "com.apple.security.exception.iokit-user-client-class")
		(iokit-registry-entry-class "AppleKeyStore")
	)
)

(allow ipc-posix-shm-read-data
	(require-all
		(ipc-posix-name "apple.shm.notification_center")
		(require-not (%entitlement-is-bool-true "com.apple.security.on-demand-install-capable"))
	)
)

(deny job-creation)

(deny lsopen
	(profile-flag "deny-lsopen")
)

(allow mach-bootstrap)

(allow mach-cross-domain-lookup)

(allow mach-derive-port)

(allow mach-lookup
	(require-all
		(global-name "com.apple.system.notification_center")
		(%entitlement-is-bool-true "com.apple.security.on-demand-install-capable")
	)
)
(allow mach-lookup
	(require-any
		(extension "com.apple.security.exception.mach-lookup.global-name")
		(extension "com.apple.security.exception.mach-lookup.local-name")
		(global-name "com.apple.CARenderServer")
		(global-name "com.apple.DragUI.druid.paste-announcement")
		(global-name "com.apple.FileCoordination")
		(global-name "com.apple.FileProvider")
		(global-name "com.apple.audio.SystemSoundServer-iOS")
		(global-name "com.apple.backboard.hid-services.xpc")
		(global-name "com.apple.backboard.hid.services")
		(global-name "com.apple.coreservices.uasharedpasteboardmanager.xpc")
		(global-name "com.apple.fontservicesd")
		(global-name "com.apple.lsd.advertisingidentifiers")
		(global-name "com.apple.lsd.openurl")
		(global-name "com.apple.tccd")
	)
)
(deny mach-lookup
	(require-any
		(xpc-service-name "com.apple.CoreGraphics.CGPDFService")
		(xpc-service-name "com.apple.WebKit.*")
	)
)

(allow mach-register
	(extension "com.apple.security.exception.mach-register.global-name")
)

(allow mach-task-exception-port-set)

(allow mach-task-inspect
	(target self)
)

(allow mach-task-name
	(target self)
)

(allow mach-task-read
	(target self)
)

(allow mach-task-special-port*)

(allow necp-client-open)

(allow nvram*)

(allow process-codesigning)

(allow process-exec*
	(literal "/System/Library/Frameworks/UIKit.framework/Support/pasteboardd")
)

(allow process-info*)

(allow process-iopolicy*)

(allow sandbox-check)

(allow signal
	(target self)
)

(allow socket-option-get)

(allow socket-option-set)

(allow sysctl-read)

(deny system-kas-info)

(with-filter (mac-policy-name "Sandbox")
	(allow system-mac-syscall
		(mac-syscall-number 5)
	)
)

(allow system-memorystatus-control)

(allow system-privilege)

(allow user-preference-read
	(preference-domain "com.apple.iclouddrive.features")
)

(allow managed-preference-read
	(preference-domain "com.apple.iclouddrive.features")
)

(allow exception-entitlement)

(allow process-exec-update-label)
