		(require-any
			(require-all
				(require-any
					(subpath "${FRONT_USER_HOME}")
					(subpath "${HOME}")
				)
				(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Containers/(Temp/)?Data/[^/]+/[^/]+(/Library/Caches)?/StoreKit(/|$)")
