(deny mach-lookup
	(require-any
		(xpc-service-name "com.apple.CoreGraphics.CGPDFService")
		(xpc-service-name "com.apple.WebKit.*")
	)
)

(allow mach-register
	(extension "com.apple.security.exception.mach-register.global-name")
)

(allow mach-task-exception-port-set)

(allow mach-task-inspect
	(target self)
)

(allow mach-task-name
	(target self)
)

(allow mach-task-read
	(target self)
)

(allow mach-task-special-port*)

(allow necp-client-open)

(allow network-inbound
	(%entitlement-is-bool-true "com.apple.developer.networking.multicast")
)

(allow network-bind
	(%entitlement-is-bool-true "com.apple.developer.networking.multicast")
)

(allow network-outbound)

(allow nvram*)

(allow process-codesigning)

(allow process-info*)

(allow process-iopolicy*)

(allow sandbox-check)

(allow signal
	(target self)
)

(allow socket-option-get)

(allow socket-option-set)

(allow syscall-unix
	(syscall-number
		SYS_flock
		SYS___channel_open
		SYS___channel_get_info
		SYS___channel_sync
		SYS___channel_get_opt
		SYS___channel_set_opt)
)

(allow sysctl-read
	(require-all
		(sysctl-name "kern.bootsessionuuid")
		(signing-identifier "com.apple.*")
	)
)
(allow sysctl-read
	(require-any
		(sysctl-name "kern.ipc.maxsockbuf")
		(sysctl-name "kern.nisdomainname")
		(sysctl-name "net.routetable.*")
		(sysctl-name "net.statistics")
	)
)

(allow system-fsctl
	(fsctl-command APFSIOC_GET_DIR_STATS APFSIOC_GET_DIR_STATS_EXT)
)

(deny system-kas-info)

(with-filter (mac-policy-name "Sandbox")
	(allow system-mac-syscall
		(mac-syscall-number 5)
	)
)

(allow system-memorystatus-control)

(allow system-privilege)

(allow system-socket
	(require-all
		(socket-domain AF_SYSTEM)
		(socket-protocol 2)
	)
)
(allow system-socket
	(socket-domain 39 AF_ROUTE)
)

(allow user-preference-read
	(require-all
		(preference-domain "com.apple.itunesstored")
		(process-attribute is-apple-signed-executable)
		(require-not (%entitlement-is-bool-true "com.apple.itunesstored.private"))
	)
)
(allow user-preference-read
	(require-any
		(preference-domain "com.apple.AppSupport")
		(preference-domain "com.apple.CFNetwork")
		(preference-domain "com.apple.LanguageModeling")
		(preference-domain "com.apple.Metal")
		(preference-domain "com.apple.UIKit")
		(preference-domain "com.apple.VideoProcessing")
		(preference-domain "com.apple.avfoundation")
		(preference-domain "com.apple.coreaudio")
		(preference-domain "com.apple.coremedia")
		(preference-domain "com.apple.corevideo")
		(preference-domain "com.apple.homed")
		(preference-domain "com.apple.iclouddrive.features")
		(preference-domain "com.apple.iokit.IOMobileGraphicsFamily")
		(preference-domain "com.apple.mediaanalysis")
		(preference-domain "com.apple.mediaanalysisd")
		(preference-domain "com.apple.mobileipod")
		(preference-domain "com.apple.mobileslideshow")
		(preference-domain "com.apple.opengl")
	)
)

(allow managed-preference-read
	(require-all
		(preference-domain "com.apple.itunesstored")
		(process-attribute is-apple-signed-executable)
		(require-not (%entitlement-is-bool-true "com.apple.itunesstored.private"))
	)
)
(allow managed-preference-read
	(require-any
		(preference-domain "com.apple.AppSupport")
		(preference-domain "com.apple.CFNetwork")
		(preference-domain "com.apple.LanguageModeling")
		(preference-domain "com.apple.Metal")
		(preference-domain "com.apple.UIKit")
		(preference-domain "com.apple.VideoProcessing")
		(preference-domain "com.apple.avfoundation")
		(preference-domain "com.apple.coreaudio")
		(preference-domain "com.apple.coremedia")
		(preference-domain "com.apple.corevideo")
		(preference-domain "com.apple.homed")
		(preference-domain "com.apple.iclouddrive.features")
		(preference-domain "com.apple.iokit.IOMobileGraphicsFamily")
		(preference-domain "com.apple.mediaanalysis")
		(preference-domain "com.apple.mediaanalysisd")
		(preference-domain "com.apple.mobileipod")
		(preference-domain "com.apple.mobileslideshow")
		(preference-domain "com.apple.opengl")
	)
)

(allow user-preference-write
	(require-any
		(preference-domain "com.apple.VideoProcessing")
		(preference-domain "com.apple.mediaanalysis")
		(preference-domain "com.apple.mediaanalysisd")
		(preference-domain "com.apple.mobileslideshow")
	)
)

(allow exception-entitlement)

(allow process-exec-update-label)
