			(require-all
				(subpath "/private/var")
				(regex #"^/private/var/(((mobile|euser[0-9]+)|[-0-9A-F]+)|Users/[^/]+)/Containers/Shared/AppGroup/[^/]+/")
				(subpath "${FRONT_USER_HOME}")
			)
			(subpath "/private/var/PersonaVolumes/[^/]+/Containers/Shared/AppGroup/[^/]+")
		)
	)
)

