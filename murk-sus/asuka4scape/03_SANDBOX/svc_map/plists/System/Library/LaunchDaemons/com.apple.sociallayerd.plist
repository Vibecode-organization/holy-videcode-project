			<string>/System/Library/PrivateFrameworks/SocialLayer.framework/sociallayerd.app</string>
		</array>
	</dict>
	<key>Program</key>
	<string>/System/Library/PrivateFrameworks/SocialLayer.framework/sociallayerd.app/sociallayerd</string>
</dict>
</plist>
