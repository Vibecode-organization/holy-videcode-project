<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnablePressuredExit</key>
	<true/>
	<key>Label</key>
	<string>com.apple.DeviceConfigurationAgent</string>
	<key>LaunchEvents</key>
	<dict>
		<key>com.apple.bg.system.task</key>
		<dict>
			<key>com.apple.DeviceConfigurationAgent.initial-sync</key>
			<dict>
				<key>Priority</key>
				<string>Utility</string>
				<key>RequiresExternalPower</key>
				<false/>
				<key>NonRepeatingTask</key>
				<dict>
					<key>ScheduleAfter</key>
					<integer>120</integer>
					<key>TrySchedulingBefore</key>
					<integer>150</integer>
				</dict>
			</dict>
		</dict>
		<key>com.apple.DeviceConfiguration.system.effective-configuration-changed</key>
		<dict>
			<key>com.apple.DeviceConfigurationAgent.system.effective-configuration-changed</key>
			<dict>
				<key>ConfigurationIDs</key>
				<array>
					<string>all</string>
				</array>
			</dict>
		</dict>
	</dict>
	<key>MachServices</key>
	<dict>
		<key>com.apple.DeviceConfigurationAgent.consumer</key>
		<true/>
		<key>com.apple.DeviceConfigurationAgent.consumer.async</key>
		<true/>
		<key>com.apple.DeviceConfigurationAgent.consumer.private</key>
		<true/>
		<key>com.apple.DeviceConfigurationAgent.consumer.private.async</key>
		<true/>
		<key>com.apple.DeviceConfigurationAgent.diagnostics.async</key>
		<true/>
		<key>com.apple.DeviceConfigurationAgent.provider</key>
		<true/>
		<key>com.apple.DeviceConfigurationAgent.provider.async</key>
		<true/>
		<key>com.apple.DeviceConfigurationAgent.publisher</key>
		<dict>
			<key>_ExperimentalNonLaunching</key>
			<true/>
		</dict>
	</dict>
	<key>ProcessType</key>
	<string>Adaptive</string>
	<key>Program</key>
	<string>/System/Library/PrivateFrameworks/DeviceConfiguration.framework/DeviceConfigurationAgent</string>
	<key>PublishesEvents</key>
	<array>
		<string>com.apple.DeviceConfiguration.user.effective-configuration-changed</string>
	</array>
	<key>UserName</key>
	<string>mobile</string>
</dict>
</plist>
