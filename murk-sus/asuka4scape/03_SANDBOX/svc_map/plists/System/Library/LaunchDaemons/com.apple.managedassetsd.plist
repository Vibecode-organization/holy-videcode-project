<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple.managedassetsd</string>
	<key>POSIXSpawnType</key>
	<string>Interactive</string>
	<key>MachServices</key>
	<dict>
		<key>com.apple.managedassetsd</key>
		<true/>
		<key>com.apple.aps.managedassetsd</key>
		<true/>
	</dict>
	<key>EnableTransactions</key>
	<true/>
	<key>EnablePressuredExit</key>
	<true/>
	<key>UserName</key>
	<string>mobile</string>
	<key>GroupName</key>
	<string>mobile</string>
	<key>Program</key>
	<string>/usr/libexec/managedassetsd</string>
	<key>PublishesEvents</key>
	<array>
		<string>com.apple.managedassetsd.notification</string>
	</array>
	<key>LaunchEvents</key>
	<dict>
        <key>com.apple.bg.system.task</key>
		<dict>
            <key>com.apple.managedassets.postinstall</key>
            <dict>
                <key>PostInstall</key>
                <true/>
                <key>Priority</key>
                <string>Utility</string>
            </dict>
            <key>com.apple.managedassets.repeatingTask</key>
            <dict>
                <key>Priority</key>
                <string>Utility</string>
                <key>RequiresExternalPower</key>
                <false/>
                <key>RequiresNetworkConnectivity</key>
                <false/>
                <key>RepeatingTask</key>
                <dict>
                    <key>Interval</key>
                    <integer>3600</integer>
                    <key>MinDurationBetweenInstances</key>
                    <integer>2880</integer>
                </dict>
            </dict>
		</dict>
	</dict>
</dict>
</plist>
