<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple.milod</string>
	<key>MachServices</key>
	<dict>
		<key>com.apple.milod.xpc.service</key>
		<true/>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/milod</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>MallocStackLoggingDirectory</key>
		<string>/private/var/tmp/com.apple.milod</string>
	</dict>
	<key>UserName</key>
	<string>mobile</string>
	<key>GroupName</key>
	<string>mobile</string>
	<key>EnablePressuredExit</key>
	<true/>
	<key>EnableTransactions</key>
	<true/>
	<key>POSIXSpawnType</key>
	<string>Adaptive</string>
	<key>LaunchEvents</key>
	<dict>
		<key>com.apple.AudioAccessoryDiscovery</key>
		<dict>
			<key>SecureSensorConnection</key>
			<dict>
				<key>discoveryTypes</key>
				<array>
					<string>SecureSensor</string>
				</array>
				<key>targetDeviceClasses</key>
				<array>
					<string>iPhone</string>
				</array>
			</dict>
		</dict>
		<key>com.apple.notifyd.matching</key>
		<dict>
			<key>AccessibilityEnvironmentDescriptionLowLatencyModeEnabled</key>
			<dict>
				<key>Notification</key>
				<string>AccessibilityEnvironmentDescriptionLowLatencyModeEnabled</string>
			</dict>
			<key>AccessibilityEnvironmentDescriptionLowLatencyModeDisabled</key>
			<dict>
				<key>Notification</key>
				<string>AccessibilityEnvironmentDescriptionLowLatencyModeDisabled</string>
			</dict>
			<key>RTLocationsOfInterestDidClearNotification</key>
			<dict>
				<key>Notification</key>
				<string>RTLocationsOfInterestDidClearNotification</string>
			</dict>
			<key>RTLocationsOfInterestDidChangeNotification</key>
			<dict>
				<key>Notification</key>
				<string>RTLocationsOfInterestDidChangeNotification</string>
			</dict>
			<key>com.apple.Preferences.ResetPrivacyWarningsNotification</key>
			<dict>
				<key>Notification</key>
				<string>com.apple.Preferences.ResetPrivacyWarningsNotification</string>
			</dict>
			<key>com.apple.mobile.keybagd.lock_status</key>
			<dict>
				<key>Notification</key>
				<string>com.apple.mobile.keybagd.lock_status</string>
			</dict>
		</dict>
	</dict>
	<key>_Conclave</key>
	<string>com.apple.milod.conclave</string>
</dict>
</plist>
